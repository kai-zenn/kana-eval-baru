# Copy file ini menjadi ".env" lalu isi nilai di bawah sebelum menjalankan
# mock_nlp_service.py atau evaluate_matching.py.

# --- Database PostgreSQL --------------------------------------------------
# TODO: ISI INI - pakai salah satu: DATABASE_URL saja (disarankan), ATAU field
# DB_* di bawahnya kalau provider kamu tidak kasih connection string tunggal.
DATABASE_URL=postgresql://user:pass@host:port/dbname

# TODO: ISI INI (opsional, kalau tidak pakai DATABASE_URL)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- NLP Service -----------------------------------------------------------
# TODO: ISI INI - default sudah mengarah ke mock service lokal di port 8001.
NLP_BASE_URL=http://localhost:8001

# TODO: ISI INI - shared secret. Harus SAMA PERSIS antara mock/real service,
# evaluate_matching.py, dan backend Go.
NLP_SERVICE_API_KEY=ganti-dengan-secret-kamu

# "mock" (default, pakai mock_nlp_service.py) atau "real" (pakai NLP service
# asli rekan tim). Ganti hanya variabel ini untuk pindah mode.
NLP_MODE=mock

# Parameter Stage 2/3 yang dikirim ke NLP service
# (final_top_k dihitung otomatis oleh evaluate_matching.py dari EVAL_K_VALUES)
NLP_BM25_TOP_K=10
NLP_SEMANTIC_THRESHOLD=0.80

# --- Evaluasi ----------------------------------------------------------------
STAGE1_RADIUS_KM=50
EVAL_K_VALUES=3,5
OUTPUT_CSV_PATH=results.csv
OUTPUT_MARKDOWN_PATH=results.md
SEED_PRODUCTS_PATH=seed_products.json
SEED_QUERIES_PATH=seed_queries.json

# --- Revisi Metrik Tambahan (baris baru, tidak mengubah baris di atas) -------
# Persentil untuk metrik P95 Latency (mis. 95 = P95, 99 = P99).
EVAL_PERCENTILE_LATENCY=95
